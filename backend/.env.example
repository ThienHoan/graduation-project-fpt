PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret

# Số phút staff giữ lock trả lời trước khi hội thoại tự mở lại (mặc định 20)
CHAT_STAFF_LOCK_TIMEOUT_MINUTES=20
# Số phút một phiên "quản lý hỗ trợ" giữ hiệu lực, tự gia hạn khi có tin mới
# hoặc khi quản lý đọc hội thoại (mặc định 30)
CHAT_MANAGER_SUPPORT_TTL_MINUTES=30

# Router chat CSKH (STAFF > FAQ > DB > AI) luôn bật cho auto-reply và gợi ý
# cho staff; không còn cờ tắt vì code legacy đã được xoá.
# Cho phép tự trả thông tin ngân hàng/STK từ cấu hình FAQ. Mặc định false:
# mọi câu hỏi STK đều chuyển nhân viên.
BANK_ACCOUNT_AUTO_REPLY=false
# Handoff thường tự hết hạn sau bao nhiêu phút (mặc định 30).
CHAT_HANDOFF_TTL_MINUTES=30
# Handoff nhạy cảm (khiếu nại/hoàn tiền/thanh toán...) giữ hiệu lực lâu hơn để
# bot không chen tư vấn bán hàng (mặc định 1440 = 24 giờ).
CHAT_HANDOFF_SENSITIVE_TTL_MINUTES=1440
# Số ngày giữ bảng chat_assistant_events trước khi job 03:30 dọn (mặc định 90).
CHAT_EVENTS_RETENTION_DAYS=90

REPLICATE_API_TOKEN=
REPLICATE_FACE_SWAP_MODEL=cdingram/face-swap
REPLICATE_FULL_BODY_MODEL=yisol/idm-vton
AI_TRYON_MAX_IMAGE_MB=8
AI_TRYON_POLL_INTERVAL_MS=2000
AI_TRYON_TIMEOUT_SECONDS=180

# ── AI text provider (chat completions kiểu OpenAI) ──────────────────────
# Dùng cho auto-reply, gợi ý AI và gợi ý giá. Mặc định là OpenRouter.
# Gemini có endpoint tương thích OpenAI:
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-flash-latest
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=replace-with-provider-api-key
AI_MODEL=openai/gpt-4o-mini
# Tùy chọn: model dự phòng khi model chính lỗi/timeout
AI_FALLBACK_MODEL=
# Timeout mỗi lần gọi AI (ms)
AI_TIMEOUT_MS=25000
# Giới hạn token đầu ra (JSON 3 topic + model có "thinking" cần nhiều hơn 512)
AI_MAX_TOKENS=2048

# ── Giám định ảnh trả hàng: LUÔN dùng OpenRouter, độc lập với AI_* ────────
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# Các biến cũ vẫn được đọc khi không khai báo AI_* ở trên.
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_FALLBACK_MODEL=
# OPENROUTER_TIMEOUT_MS=25000
# OPENROUTER_MAX_TOKENS=1024
# Override riêng cho vision nếu cần: VISION_BASE_URL / VISION_API_KEY / VISION_MODEL

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOONG_API_KEY=replace-with-goong-api-key
GOGODUK_API_KEY=replace-with-gogoduk-api-key
GOGODUK_BASE_URL=https://api.gogoduk.com

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Cấu hình gửi mail (Gmail App Password)
SMTP_SERVICE=gmail
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_PORT=465
SMTP_SECURE=true

# Tùy chọn: Redis dùng cho cache, khoá auto-reply phân tán và rate limit
# dùng chung giữa nhiều instance. Bỏ trống để dùng in-memory fallback.
REDIS_URL=
