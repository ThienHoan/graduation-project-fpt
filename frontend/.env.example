NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Tùy chọn: URL Socket.IO (namespace /chat) khi chạy tách domain.
# Bỏ trống sẽ suy ra từ NEXT_PUBLIC_API_URL (bỏ hậu tố /api hoặc /backend-api).
# Ví dụ production: https://cophuctruyenthong.tech/chat
NEXT_PUBLIC_SOCKET_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-client-id
NEXT_PUBLIC_SUPABASE_URL=replace-with-supabase-url
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_ASSETS_BUCKET=products

# Goong Map (Tùy chọn: Nhập API key của Goong để tải map nội địa VN và tính lộ trình đường bộ)
NEXT_PUBLIC_GOONG_API_KEY=your_goong_api_key_here
NEXT_PUBLIC_GOONG_MAPTILES_KEY=your_goong_maptiles_key_here

# Decart AI Real-time Virtual Try-On
DECART_API_KEY=dct_your_api_key_here
